<configuration debug="false">
    <import class="ch.qos.logback.core.FileAppender"/>
    <import class="ch.qos.steward.classic.stream.KryoEncoder"/>

    <appender name="FILE" class="FileAppender">
        <file>${perfTarget:-target/test-output/}kryo-encoder-perf.kryo</file>
        <!-- Larger buffer reduces frequency of writes to the OS page cache.
             On rotating media this can modestly reduce variance caused by
             the kernel writeback flusher. -->
        <bufferSize>1MB</bufferSize>
        <immediateFlush>false</immediateFlush>
        <append>false</append>
        <encoder class="KryoEncoder">
<!--            <serializerType>Vanilla</serializerType>-->
            <serializerType>Custom</serializerType>
            <streamVersion>4</streamVersion>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="FILE" />
    </root>
</configuration>
